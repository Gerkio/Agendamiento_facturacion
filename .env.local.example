# ============================================================
#  CleanSched & Direct Billing Colombia — Variables de entorno
#  Copia este archivo a `.env.local` y rellena los valores.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# SECRETA (solo servidor): crea/gestiona usuarios de limpiadores vía Admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── DIAN: Certificado de firma ──────────────────────────────
# El certificado que entrega la DIAN viene en formato .pfx / .p12.
# Node.js firma con claves en PEM, así que debes convertir el .pfx
# UNA sola vez a dos valores base64 (clave privada + certificado).
#
#   node scripts/pfx-to-env.mjs ruta/al/certificado.pfx TU_PASSWORD
#
# Ese script imprime exactamente las dos líneas siguientes ya listas:
DIAN_PRIVATE_KEY_BASE64=base64-del-PEM-de-la-clave-privada
DIAN_CERTIFICATE_BASE64=base64-del-PEM-del-certificado

# Password del .pfx — sólo lo usa scripts/pfx-to-env.mjs (no en runtime).
DIAN_CERTIFICATE_PASSWORD=your-pfx-password

# ── DIAN: Identificación del software (Resolución) ──────────
# Asignados por la DIAN al habilitar el software de facturación.
DIAN_SOFTWARE_ID=00000000-0000-0000-0000-000000000000
DIAN_SOFTWARE_PIN=12345
# Clave técnica (ClvTec) de la resolución de numeración.
DIAN_TECHNICAL_KEY=your-technical-key

# Ambiente DIAN: 1 = Producción, 2 = Pruebas (Sandbox)
DIAN_ENVIRONMENT=2
# Mismo valor, expuesto al cliente para el banner del panel de Debug.
NEXT_PUBLIC_DIAN_ENV=2

# ── Validaciones (Secure by Default) ────────────────────────
# Bloquear el envío si el XML no cumple el esquema UBL 2.1 ('false' = solo advertir).
DIAN_XSD_ENFORCE=true
# Bloquear si falla el Schematron de reglas de negocio ('false' = solo auditar hallazgos).
# Por defecto false hasta validar el generador contra todas las reglas estructurales.
DIAN_SCHEMATRON_ENFORCE=false
# Días para alertar de vencimiento próximo del certificado.
DIAN_CERT_EXPIRY_WARNING_DAYS=30
# (Opcional) Cadena de la Autoridad Certificadora (PEM concatenados, base64) para
# verificar la cadena de confianza del certificado. Si falta, se marca "no verificada".
DIAN_CA_BUNDLE_BASE64=

# ── Empresa / Emisor (datos fijos del SME de aseo) ──────────
COMPANY_NIT=900123456
COMPANY_DV=1
COMPANY_NAME=Empresa de Aseo S.A.S.
COMPANY_ADDRESS=Calle 123 # 45-67, Bogotá
COMPANY_CITY_CODE=11001
COMPANY_TAX_SCHEME=01
COMPANY_FISCAL_REGIMEN=O-13
COMPANY_EMAIL=facturacion@empresa.com
COMPANY_PHONE=6011234567
# Tasa de IVA en % aplicada a los servicios. 0 = exento (por defecto).
# ⚠️ Confírmala con el contador. Si aplica el régimen AIU de aseo/vigilancia,
# el IVA va sobre la base AIU y requiere lógica adicional (no solo cambiar este número).
COMPANY_IVA_RATE=0

# ── Resolución de numeración de facturas ────────────────────
INVOICE_PREFIX=SETT
# Prefijo del consecutivo de notas crédito (no requiere resolución de numeración).
CREDIT_NOTE_PREFIX=NC
INVOICE_RESOLUTION_NUMBER=18764000001
INVOICE_RESOLUTION_DATE=2023-01-01
INVOICE_FROM_NUMBER=1
INVOICE_TO_NUMBER=1000
