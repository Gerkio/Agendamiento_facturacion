{
  "name": "cleansched-billing",
  "version": "1.0.0",
  "description": "Scheduling and DIAN billing app for cleaning business",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "check:dian": "node scripts/check-dian-artifacts.mjs",
    "verify:sign": "node scripts/verify-signature.mjs",
    "build:schematron": "node scripts/build-schematron.mjs",
    "align:generator": "node --conditions=react-server scripts/align-generator.mjs",
    "validate:credit-note": "node --conditions=react-server scripts/validate-credit-note.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/speed-insights": "^2.0.0",
    "@xmldom/xmldom": "^0.9.10",
    "next": "^16.2.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "saxon-js": "^2.7.0",
    "server-only": "^0.0.1",
    "xml-crypto": "^6.1.2",
    "xmllint-wasm": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
